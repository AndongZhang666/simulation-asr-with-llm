{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asr-llm-ec.local/schemas/ec_output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["utt_id", "ec_system_id", "decoding_strategy", "output_raw", "output_normalized", "selected_candidate_rank", "lambda_value", "ec_sequence_score", "asr_sequence_score", "combined_score", "parser_status", "latency_ms", "truncated", "provenance"],
  "properties": {
    "utt_id": {"type": "string", "minLength": 1},
    "ec_system_id": {"type": "string", "minLength": 1},
    "decoding_strategy": {"type": "string", "minLength": 1},
    "output_raw": {"type": "string"},
    "output_normalized": {"type": "string"},
    "selected_candidate_rank": {"type": ["integer", "null"], "minimum": 1},
    "lambda_value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "ec_sequence_score": {"type": ["number", "null"]},
    "asr_sequence_score": {"type": ["number", "null"]},
    "combined_score": {"type": ["number", "null"]},
    "parser_status": {"enum": ["not_applicable", "parsed", "empty", "malformed", "truncated", "provider_error"]},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "truncated": {"type": "boolean"},
    "provenance": {"type": "object"}
  }
}