{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asr-llm-ec.local/schemas/llm_exchange.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_hash", "provider", "model_id", "messages", "generation_parameters", "requested_utc", "response_utc", "raw_response", "parsed_output", "selected_candidate_rank", "parser_status", "input_tokens", "output_tokens", "latency_ms", "retry_count", "errors"],
  "properties": {
    "request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {"role": {"type": "string", "minLength": 1}, "content": {"type": "string"}}
      }
    },
    "generation_parameters": {"type": "object"},
    "requested_utc": {"type": "string", "minLength": 1},
    "response_utc": {"type": ["string", "null"]},
    "raw_response": {"type": ["string", "null"]},
    "parsed_output": {
      "type": ["object", "null"],
      "properties": {"raw": {"type": "string"}, "normalized": {"type": "string"}},
      "required": ["raw", "normalized"]
    },
    "selected_candidate_rank": {"type": ["integer", "null"], "minimum": 1},
    "parser_status": {"enum": ["not_applicable", "parsed", "empty", "malformed", "truncated", "provider_error"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}